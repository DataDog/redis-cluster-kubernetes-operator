# syntax=docker/dockerfile:1

FROM golang:1.25.14-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/redis-cluster-kubernetes-operator ./cmd

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/redis-cluster-kubernetes-operator /usr/local/bin/redis-cluster-kubernetes-operator
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/redis-cluster-kubernetes-operator"]
